{% include "header.jinja2" %}

<div role="alert" class="alert alert-warning block md:hidden mb-4">
	<span>Not designed for small screens ¯\_(ツ)_/¯</span>
</div>

<div class="flex flex-wrap items-center gap-2 mb-6">
	<input type="search" id="search-input" placeholder="Search products…" aria-controls="data-table"
	       class="input input-bordered input-sm flex-1 min-w-[200px]">

	<div class="flex flex-wrap items-center gap-2">
		<label class="label cursor-pointer gap-2 border border-base-300 rounded-btn px-3 py-1.5">
			<span class="label-text text-sm">Show sugar</span>
			<input type="checkbox" id="show-sugar" checked class="toggle toggle-sm toggle-primary">
		</label>
		<label class="label cursor-pointer gap-2 border border-base-300 rounded-btn px-3 py-1.5">
			<span class="label-text text-sm">Show discontinued</span>
			<input type="checkbox" id="hide-discontinued" class="toggle toggle-sm toggle-primary">
		</label>

		<div class="dropdown dropdown-end" id="columns-dropdown">
			<div tabindex="0" role="button" class="btn btn-sm btn-outline gap-1">
				Columns
                <i data-lucide="chevron-down" class="w-3 h-3"></i>
			</div>
			<ul tabindex="0" class="dropdown-content menu menu-sm bg-base-100 rounded-box z-10 w-64 p-2 shadow border border-base-300">
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="1" checked><span class="label-text">Size</span></label></li>
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="2" checked><span class="label-text">Packaging</span></label></li>
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="3"><span class="label-text">Avg Price</span></label></li>
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="4"><span class="label-text">Price per 100ml</span></label></li>
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="5"><span class="label-text">Caffeine (mg/100ml)</span></label></li>
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="6" checked><span class="label-text">Caffeine Total</span></label></li>
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="7"><span class="label-text">Caffeine per Sugar</span></label></li>
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="8"><span class="label-text">Price per Caffeine</span></label></li>
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="9"><span class="label-text">Sugar (g/100ml)</span></label></li>
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="10" checked><span class="label-text">Sugar Total</span></label></li>
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="11"><span class="label-text">Sugar per Caffeine</span></label></li>
				<li><label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm toggle-column" data-column="12" checked><span class="label-text">Score</span></label></li>
			</ul>
		</div>
	</div>
</div>

<div class="overflow-x-auto">
	<table id="data-table" class="table table-zebra table-sm">
		<thead>
			<tr>
				<th>Product</th>
				<th class="text-right">Size<br><span class="text-xs opacity-60">(ml)</span></th>
				<th class="text-right">Packaging</th>
				<th class="text-right">Avg. Price<br><span class="text-xs opacity-60">(CHF)</span></th>
				<th class="text-right">Price/100ml<br><span class="text-xs opacity-60">(CHF)</span></th>
				<th class="text-right">Caffeine<br><span class="text-xs opacity-60">(mg/100ml)</span></th>
				<th class="text-right">Caffeine Total<br><span class="text-xs opacity-60">(mg)</span></th>
				<th class="text-right">Caffeine/1g Sugar<br><span class="text-xs opacity-60">(mg)</span></th>
				<th class="text-right">Price/1mg Caffeine<br><span class="text-xs opacity-60">(CHF)</span></th>
				<th class="text-right">Sugar<br><span class="text-xs opacity-60">(g/100ml)</span></th>
				<th class="text-right">Sugar Total<br><span class="text-xs opacity-60">(g)</span></th>
				<th class="text-right">Sugar/1mg Caffeine<br><span class="text-xs opacity-60">(g)</span></th>
				<th class="text-right">
					Score
					<span class="tooltip tooltip-left" data-tip="Caffeine / ((Sugar + 1) x Avg. Price)">
						<span class="underline decoration-dotted cursor-help">(?)</span>
					</span>
				</th>
			</tr>
		</thead>
		<tbody>
			{% for item in products %}
			<tr{% if item.discontinued %} class="opacity-60"{% endif %}>
				<td>
					<a href="/products/{{ item['siteurl'] }}" class="link link-hover{% if item.discontinued %} line-through{% endif %}">{{ item["brand"] }} {{ item["product"] }}</a>
					{% if item.discontinued %}<span class="text-xs opacity-70"> No longer available</span>{% endif %}
				</td>
				<td class="text-right">{{ item["size"] }}</td>
				<td class="text-right">{{ item["packaging"] }}</td>
				<td class="text-right">{{ item["averageprice"] }}</td>
				<td class="text-right">{{ item["price100ml"] }}</td>
				<td class="text-right">{{ item["caffeine"] }}</td>
				<td class="text-right">{{ item["caffeinetotal"] }}</td>
				<td class="text-right">{{ item["caffeine1gsugar"] }}</td>
				<td class="text-right">{{ item["price1mgcaffeine"] }}</td>
				<td class="text-right">{{ item["sugar"] }}</td>
				<td class="text-right">{{ item["sugartotal"] }}</td>
				<td class="text-right">{{ item["sugar1mgcaffeine"] }}</td>
				<td class="text-right">{{ item["score"] }}</td>
			</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

<script>
$(document).ready(function() {
	var table = $('#data-table').DataTable({
		order: [[0, 'asc']],
		columnDefs: [
			{ targets: [3, 4, 5, 7, 8, 9, 11], visible: false }
		],
		scrollX: true,
		paging: false,
		bInfo: false,
		searching: true,
		layout: {
			topEnd: null,
		},
	});

	$('#search-input').on('keyup', function () {
		table.search(this.value).draw();
	});

	$('.toggle-column').on('change', function() {
		var column = table.column($(this).data('column'));
		column.visible($(this).is(':checked'));
	});

	table.columns().every(function(index) {
		if (index > 0) {
			var checkbox = $('.toggle-column[data-column="' + index + '"]');
			checkbox.prop('checked', this.visible());
		}
	});

	$.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
		if ($('#show-sugar').is(':checked')) return true;
		var sugarVal = parseFloat(data[9]); // Sugar column is now index 9
		return sugarVal === 0 || (isNaN(sugarVal) && data[9].trim() === '0');
	});

	$('#show-sugar').on('change', function() {
		table.draw();
	});

	$.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
		if ($('#hide-discontinued').is(':checked')) return true;
		var $row = $(table.row(dataIndex).node());
		return !$row.hasClass('opacity-60');
	});

	$('#hide-discontinued').on('change', function() {
		table.draw();
	});

	table.draw();
});
</script>

{% include "footer.jinja2" %}